# ============================================================================
# TrackIntake Frontend Environment Configuration Example (.env.example)
# ============================================================================
# Copy this file to .env and adjust values as needed:
# cp .env.example .env
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API Base URL used by Vite during development and build:
#
# - Local Development (default):
#   VITE_API_BASE_URL=http://localhost:8000
#
# - Production Deployment (e.g. Render):
#   VITE_API_BASE_URL=https://trackintake-backend.onrender.com
#
VITE_API_BASE_URL=http://localhost:8000
