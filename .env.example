# ============================================================================
# TrackIntake Frontend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# This file is used by Vite during build time
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API base URL - must match your backend deployment
# For production (Render): https://your-backend.onrender.com
# For development (local): http://localhost:8000
# For development (Render backend): https://your-backend.onrender.com
# 
# NOTE: The frontend config.js automatically detects the environment:
# - If hostname includes 'onrender.com': uses https://trackintake-backend.onrender.com
# - If hostname is localhost/127.0.0.1: uses http://localhost:8000
# - Otherwise: uses this VITE_API_BASE_URL value
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
# Local Development:
#   VITE_API_BASE_URL=http://localhost:8000
#   Run: npm run dev
#   Access: http://localhost:5173
#
# Production (Render):
#   VITE_API_BASE_URL=https://your-backend.onrender.com
#   Run: npm run build
#   Access: https://your-frontend.onrender.com
#
# The frontend automatically detects the environment and uses the correct URL
# See Frontend/src/config.js for the detection logic

